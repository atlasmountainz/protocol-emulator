# The 5 MHz SPI master example (firmware/examples/spi_master_fast.asm) on the fast schedule 0,1,0,2:
# thread 0 runs one instruction every 40 ns.
program ../examples/spi_master_fast.asm
thread 0
sched 0,1,0,2
start spi_start
nonblocking
event SCK_RISE = out 1=1
event SCK_FALL = out 1=0
event MOSI     = out 2
event CS_ON    = out 0=0
event CS_OFF   = out 0=1
event FRAME_END = out 0=1 | at spi_idle


# The claims of the file header, proved for every bit of the frame (the frame ends at CS_OFF):
check SCK_RISE -> SCK_RISE == 200ns avoid FRAME_END     # 5 MHz
check SCK_RISE -> SCK_FALL == 80ns                   # SCK high 4 clocks
check SCK_FALL -> SCK_RISE == 120ns avoid FRAME_END     # SCK low 6 clocks
check MOSI -> SCK_RISE >= 40ns avoid FRAME_END          # MOSI stable 2 clocks before the sampling edge
check SCK_RISE -> MOSI in [160ns, 240ns]             # and at least 8 clocks after it (hold)
check CS_ON -> SCK_RISE == 120ns                     # CS_N falls 3 turns before the first rising edge
check SCK_FALL -> CS_OFF >= 120ns avoid SCK_RISE     # and rises 3 turns after the last falling edge
