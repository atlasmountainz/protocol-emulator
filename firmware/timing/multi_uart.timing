# The three-protocol image (firmware/examples/multi.asm), thread 3: the UART status line, 115200 baud 8N1.
# Every write to TX inside a frame is exactly one bit time after the previous one, for every byte, while
# threads 0, 1 and 2 drive the LED strip and answer on the I2C bus.
program ../examples/multi.asm
thread 3
start u_send
init A=? X=? C=?
event TX = out 0
check TX -> TX == 8.64us          # 432 clocks: 115740 baud, 0.5 % fast
